{
  "soutubot": {
    "description": "SoutuBot 搜索设置",
    "type": "object",
    "items": {
      "min_similarity": {
        "description": "最低相似度",
        "type": "float",
        "hint": "低于这个相似度的结果不会返回。SoutuBot 官方客户端使用 45 作为可信阈值。",
        "default": 45,
        "min": 0,
        "max": 100
      },
      "max_results": {
        "description": "最多解析结果数",
        "type": "int",
        "hint": "建议 1-5 条。若结果中包含 nhentai，会先返回第一个 nhentai 结果供确认。",
        "default": 3,
        "min": 1,
        "max": 10
      },
      "timeout_ms": {
        "description": "超时毫秒",
        "type": "int",
        "hint": "包含打开首页、上传搜索、API 和图片下载的单请求超时。",
        "default": 60000,
        "min": 10000,
        "max": 180000
      },
      "headless": {
        "description": "无头浏览器",
        "type": "bool",
        "hint": "部署环境通常保持开启。排查 Cloudflare/浏览器问题时可以临时关闭。",
        "default": true
      }
    }
  },
  "nhentai": {
    "description": "nhentai 原图下载设置",
    "type": "object",
    "items": {
      "download_enabled": {
        "description": "允许确认后下载结果",
        "type": "bool",
        "default": true
      },
      "cookies": {
        "description": "nhentai Cookies",
        "type": "string",
        "hint": "可填写 Netscape cookies.txt 内容、cookies.txt 文件路径，或 k=v; k2=v2 形式。不要在公开日志中输出。",
        "default": ""
      },
      "api_key": {
        "description": "nhentai API Key",
        "type": "string",
        "hint": "必填。请求 nhentai API v2 时会作为 Authorization: Key <api_key> 发送；为空时相关命令返回“未配置api”。请勿公开输出。",
        "default": ""
      },
      "proxy": {
        "description": "nhentai 代理",
        "type": "string",
        "hint": "可选。当前运行环境无法直连 nhentai 或出现 SSL EOF 时填写 HTTP/HTTPS 代理，例如 http://127.0.0.1:7890。",
        "default": ""
      },
      "max_download_pages": {
        "description": "最大下载页数",
        "type": "int",
        "default": 120,
        "min": 1,
        "max": 300
      },
      "download_retries": {
        "description": "单页下载重试次数",
        "type": "int",
        "default": 2,
        "min": 0,
        "max": 5
      },
      "block_risky_tags": {
        "description": "阻止风险标签",
        "type": "bool",
        "hint": "命中 lolicon、shotacon 等风险标签时停止自动下载。",
        "default": true
      }
    }
  },
  "jmcomic": {
    "description": "禁漫天堂下载设置",
    "type": "object",
    "items": {
      "download_enabled": {
        "description": "允许 /JJ 下载禁漫本子",
        "type": "bool",
        "default": true
      },
      "domain": {
        "description": "禁漫域名",
        "type": "string",
        "hint": "兼容旧配置。可填单个域名，也可用逗号分隔多个域名；建议改用 jmcomic.domains。",
        "default": ""
      },
      "domains": {
        "description": "禁漫域名列表",
        "type": "string",
        "hint": "可用逗号或空格分隔多个域名。插件会按顺序交给 jmcomic 轮询，避免单个域名 /setting 失败就中断。",
        "default": "18comic.vip,18comic.org,jmcomic1.me,jmcomic.me,18comic-palworld.vip,18comic-c.art,18comic-palworld.club"
      },
      "proxy": {
        "description": "禁漫代理",
        "type": "string",
        "hint": "可选。当前运行环境无法直连禁漫域名时填写 HTTP/HTTPS 代理，例如 http://127.0.0.1:7890。",
        "default": ""
      },
      "cookies": {
        "description": "禁漫 Cookies",
        "type": "string",
        "hint": "可填 Netscape cookies.txt 内容、cookies.txt 文件路径，或 k=v; k2=v2 形式。不要在公开日志中输出。",
        "default": ""
      }
    }
  },
  "pica": {
    "description": "哔咔搜索设置",
    "type": "object",
    "items": {
      "proxy": {
        "description": "哔咔代理",
        "type": "string",
        "hint": "可选。当前运行环境无法直连哔咔 API 时填写 HTTP/HTTPS 代理，例如 http://127.0.0.1:7890。",
        "default": ""
      },
      "max_results": {
        "description": "哔咔最多返回结果数",
        "type": "int",
        "hint": "/bk 文本搜索最多返回几条结果。",
        "default": 5,
        "min": 1,
        "max": 10
      }
    }
  },
  "cache": {
    "description": "缓存清理设置",
    "type": "object",
    "items": {
      "cleanup_enabled": {
        "description": "自动清理缓存",
        "type": "bool",
        "hint": "开启后会定期清空插件数据目录下的 downloads 和 cookies 缓存。",
        "default": true
      },
      "cleanup_hour": {
        "description": "每天清理时间",
        "type": "int",
        "hint": "使用服务器本地时间，默认每天 02:00 清理一次所有缓存。",
        "default": 2,
        "min": 0,
        "max": 23
      }
    }
  }
}
